/backups

# passwords and API keys - never upload
.env
.secrets

# generated by build/*.py (python3 build/<name>.py); they contain the RingCentral token
workflows/*.json

# old n8n exports (contain the RingCentral token)
/exports

# worker runtime files (call logs, progress)
worker/*.log
worker/*state*.json

__pycache__/
*.pyc
